# ====================================================================
# TradeBrain — Environment Variables
# ====================================================================
# Required keys (cannot start without these):
#   OPENROUTER_API_KEY    — Kimi K2.6 signal evaluation
#   COINBASE_API_KEY      — CDP key name (organizations/{org}/apiKeys/{key})
#   COINBASE_API_SECRET   — CDP EC private key PEM (replace \n in .env)
#   DATABASE_URL          — Neon Postgres connection string
# -------------------------------------------------------------------

OPENROUTER_API_KEY=sk-or-...
COINBASE_API_KEY=organizations/.../apiKeys/...
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
DATABASE_URL=postgresql://...

# Discord (optional but recommended for notifications)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# CryptoPanic news API (optional — C4 sentiment/news context)
# Get a free token at https://cryptopanic.com/developers/
# CRYPTOPANIC_TOKEN=your-token-here

# Trading defaults (overridable in the UI)
PAPER_TRADING=true
DEFAULT_LEVERAGE=3
DEFAULT_RISK_PER_TRADE=0.01
DEFAULT_DAILY_LOSS_LIMIT=0.05
DEFAULT_STRATEGY=rsi_macd
DEFAULT_SIGNAL_INTERVAL=300
DEFAULT_MAX_WATCHLIST=5

# Trading fees — CFM nano perp retail rate: 0.02% taker with a $0.15/fill
# minimum, which dominates at small position sizes. Applied to every
# entry/partial/exit leg in both paper and live so simulated PnL matches
# what live trading will actually cost.
# TAKER_FEE_PCT=0.0002
# MIN_FEE_USDC=0.15
# Skip a partial take-profit (adds a 3rd fee leg) if its total fee burden
# would exceed this fraction of the trade's $-at-risk.
# FEE_BUDGET_PCT_OF_RISK=0.15

# ====================================================================
# Run-plane LLM providers (MODELS.md §2, §7) — PAY-PER-TOKEN KEYS ONLY.
# Never point the run plane at a seat subscription (Claude Pro, Ollama Pro,
# OpenCode Go). The agent refuses to start on seat-subscription keys.
# ====================================================================
# Per-role providers: openrouter | zai | moonshot | ollama
# SIGNAL_PROVIDER=openrouter
# CRITIC_PROVIDER=openrouter
# BURT_PROVIDER=openrouter
# EMBEDDING_PROVIDER=openrouter
# CONSOLIDATION_PROVIDER=openrouter
# Models (empty "" falls back to SIGNAL_MODEL):
# SIGNAL_MODEL=z-ai/glm-5.3-flash
# CRITIC_MODEL=
# BURT_MODEL=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# CONSOLIDATION_MODEL=
# Reasoning effort per role ("" = omit the field). On reasoning models this is
# the dominant cost AND latency lever — reasoning tokens bill as output.
# Measured on GLM-5.3-Flash: low = ~148 output tokens / 2-5s vs ~1038 / 17-20s.
# SIGNAL_REASONING_EFFORT=low
# CRITIC_REASONING_EFFORT=high
# BURT_REASONING_EFFORT=low
# Per-role timeouts (seconds):
# SIGNAL_TIMEOUT=60
# CRITIC_TIMEOUT=90
# BURT_TIMEOUT=45
# EMBEDDING_TIMEOUT=15
# CONSOLIDATION_TIMEOUT=90
# Direct-provider keys (used when a role routes off OpenRouter):
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1   # local fallback: http://localhost:11434/v1
