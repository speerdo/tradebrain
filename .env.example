# ====================================================================
# TradeBrain — Environment Variables
# ====================================================================
# Required keys (cannot start without these):
#   OPENROUTER_API_KEY    — Kimi K2.6 signal evaluation
#   COINBASE_API_KEY      — CDP key name (organizations/{org}/apiKeys/{key})
#   COINBASE_API_SECRET   — CDP EC private key PEM (replace \n in .env)
#   DATABASE_URL          — Neon Postgres connection string
# -------------------------------------------------------------------

OPENROUTER_API_KEY=sk-or-...
COINBASE_API_KEY=organizations/.../apiKeys/...
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
DATABASE_URL=postgresql://...

# Discord (optional but recommended for notifications)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# CryptoPanic news API (optional — C4 sentiment/news context)
# Get a free token at https://cryptopanic.com/developers/
# CRYPTOPANIC_TOKEN=your-token-here

# Trading defaults (overridable in the UI)
# PAPER_TRADING selects the mode, and it must MATCH agent_config.paper_trading
# in the DB — the agent refuses to start if they disagree, and refuses to flip
# mode at runtime (agent/trading_mode.py). Paper and live are fully separate:
# separate equity source, separate trade rows, separate daily loss budget.
PAPER_TRADING=false

# ------------------------------------------------------------------
# LIVE account data (ignored in paper mode) — agent/account.py
# ------------------------------------------------------------------
# Which /cfm/balance_summary field is "the account" for position sizing and
# the daily-loss circuit breaker. total_usd_balance is the whole account:
# measured 2026-09-22 the CFM slice was $68.13 while another $131.79 sat in
# spot USD that the exchange sweeps in on demand. Sizing off cfm_usd_balance
# alone would have valued a $200 account at $68 and put the 5% daily stop at
# $3.41 — under one losing trade.
# LIVE_EQUITY_SOURCE=total_usd_balance      # or futures_buying_power / cfm_usd_balance
# Cache TTL for the balance read, shared by the loop, monitor, API and Burt.
# BALANCE_REFRESH_SEC=30
# How often account equity is snapshotted to account_snapshots (0 = never).
# ACCOUNT_SNAPSHOT_INTERVAL_SEC=300
# Refuse NEW live entries when the last good balance is older than this.
# MAX_BALANCE_STALENESS_SEC=300
# Trip the circuit breaker on the EXCHANGE's own realized P&L for the session
# as well as our modeled losses — it sees fills we don't (a stop that filled
# while the bot was down, a close from the Coinbase app).
# USE_EXCHANGE_REALIZED_PNL=true
# Pull each live order's fills into the `fills` table and write the real fill
# price + commission back onto the trade row (audit vs Coinbase's history).
# SYNC_FILLS=true
# FILL_SYNC_ATTEMPTS=4
# 5x — matches screener.py's own MIN_LEVERAGE floor, so anything the
# screener selects already supports it. At 3x the 20%-margin cap crushed
# notional down to where the $0.15/fill fee minimum dominated risk_usdc.
DEFAULT_LEVERAGE=5
DEFAULT_RISK_PER_TRADE=0.01
DEFAULT_DAILY_LOSS_LIMIT=0.05
DEFAULT_STRATEGY=rsi_macd
DEFAULT_SIGNAL_INTERVAL=300
DEFAULT_MAX_WATCHLIST=5

# Trading fees — MEASURED via /orders/preview on 2026-09-18: 0.14% of
# notional per fill (taker), no per-fill minimum. Applied to every
# entry/partial/exit leg in both paper and live so simulated PnL matches
# what live trading will actually cost. Re-check with
# `python scripts/live_preflight.py` — it flags drift from the exchange quote.
# TAKER_FEE_PCT=0.0014
# MIN_FEE_USDC=0
# Skip a partial take-profit (adds a 3rd fee leg) if its total fee burden
# would exceed this fraction of the trade's $-at-risk.
# FEE_BUDGET_PCT_OF_RISK=0.15
# Reject an entry outright if its round-trip fee alone would exceed this
# fraction of $-at-risk. With a 0.28% round trip this is purely a function
# of stop distance (0.28% / stop%), so 0.20 rejects stops tighter than ~1.4%.
# ENTRY_FEE_BUDGET_PCT_OF_RISK=0.20

# Whole-contract sizing. CFM products trade in whole contracts (1 ETH PERP =
# 0.1 ETH ~ $260; 1 NEAR PERP = 500 NEAR ~ $1,900) and the exchange charges
# margin at ITS overnight rate (24.5% ETH, 38% NEAR ...) — the LEVERAGE knob
# does not change that. The bot sizes in contracts and skips anything whose
# single contract breaks these ceilings. Run scripts/live_preflight.py to see
# what your balance can trade.
# MAX_RISK_PER_TRADE=0.04     # hard cap on one contract's $-at-risk (fraction of balance)
# MAX_MARGIN_PCT=0.50         # one position's exchange margin, fraction of balance
# REQUIRE_4H_BIAS=true        # long only above 4h EMA50, short only below

# ====================================================================
# Run-plane LLM providers (MODELS.md §2, §7) — PAY-PER-TOKEN KEYS ONLY.
# Never point the run plane at a seat subscription (Claude Pro, Ollama Pro,
# OpenCode Go). The agent refuses to start on seat-subscription keys.
# ====================================================================
# Per-role providers: openrouter | zai | moonshot | ollama
# SIGNAL_PROVIDER=openrouter
# CRITIC_PROVIDER=openrouter
# BURT_PROVIDER=openrouter
# EMBEDDING_PROVIDER=openrouter
# CONSOLIDATION_PROVIDER=openrouter
# Models (empty "" falls back to SIGNAL_MODEL):
# SIGNAL_MODEL=z-ai/glm-5.3-flash
# CRITIC_MODEL=
# BURT_MODEL=
# EMBEDDING_MODEL=openai/text-embedding-3-small
# CONSOLIDATION_MODEL=
# Reasoning effort per role ("" = omit the field). On reasoning models this is
# the dominant cost AND latency lever — reasoning tokens bill as output.
# Measured on GLM-5.3-Flash: low = ~148 output tokens / 2-5s vs ~1038 / 17-20s.
# SIGNAL_REASONING_EFFORT=low
# CRITIC_REASONING_EFFORT=high
# BURT_REASONING_EFFORT=low
# Per-role timeouts (seconds):
# SIGNAL_TIMEOUT=60
# CRITIC_TIMEOUT=90
# BURT_TIMEOUT=45
# EMBEDDING_TIMEOUT=15
# CONSOLIDATION_TIMEOUT=90
# Direct-provider keys (used when a role routes off OpenRouter):
# ZAI_API_KEY=
# MOONSHOT_API_KEY=
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com/v1   # local fallback: http://localhost:11434/v1
